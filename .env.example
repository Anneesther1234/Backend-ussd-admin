# ============================================
# CONFIGURATION BACKEND ADMIN - VOTE USSD
# Copier ce fichier en .env et remplir les valeurs
# ============================================

# Serveur
PORT=3000
NODE_ENV=development

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ton_mot_de_passe
DB_NAME=vote_ussd

# JWT Secret (changer en production !)
JWT_SECRET=vote_ussd_jwt_secret_inphb_2026
JWT_EXPIRES_IN=8h

# Google OAuth (pour l'auth admin par Gmail)
GOOGLE_CLIENT_ID=ton_google_client_id
GOOGLE_CLIENT_SECRET=ton_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Session
SESSION_SECRET=session_secret_vote_ussd_2026

# Email (Nodemailer - pour les notifications)
